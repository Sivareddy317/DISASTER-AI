# =========================================================
# DisasterAI v2.1.0 — Environment Configuration
# Copy this file to .env and fill in your values
# =========================================================

# Database (default: SQLite for dev, switch to PostgreSQL for prod)
DATABASE_URL=sqlite:///./disaster.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/disasterai

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS — comma-separated origins or * for dev
# For production, set to your Railway/Render URL
CORS_ORIGINS=*

# Speech-to-Text (set true to skip downloading Whisper model during dev)
MOCK_TRANSCRIPTION=false

# ✅ NEW: Anthropic AI (Claude Haiku) for low-confidence report fallback
# Get yours at: https://console.anthropic.com/
AI_PROVIDER_API_KEY=

# ✅ NEW: API Key to protect write endpoints (leave blank for open dev mode)
# When set, all POST/PATCH requests must include header: X-API-Key: <your-key>
APP_API_KEY=
